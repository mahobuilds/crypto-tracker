# Copy to .env for local development. Set the same names as Railway variables in production.
APP_ORIGIN=http://localhost:5173
PORT=8787
# Supabase -> Project Settings -> Database -> Connection string (URI). Use the pooler URI.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Only if your project still uses the legacy HS256 JWT secret (Project Settings -> API -> JWT Secret). Leave empty for JWKS.
SUPABASE_JWT_SECRET=
# Web Push VAPID keys: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
